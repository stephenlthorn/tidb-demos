KAFKA_CONNECT_API=http://127.0.0.1:8083
TICDC_API=http://127.0.0.1:8300

LAB_ENV_COMPONENT_POSTGRES=postgres:16
LAB_ENV_COMPONENT_KAFKA=apache/kafka 4.1.0
LAB_ENV_COMPONENT_KAFKA_CONNECT=quay.io/debezium/connect:latest

TIDB_HOST=127.0.0.1
TIDB_PORT=4000
TIDB_USER=root
TIDB_PASSWORD=
TIDB_DATABASE=lab
TIDB_TLS=false
LAB_ENV_TIDB=tiup playground (local)
LAB_ENV_NOTES=

# Credentials: never fill these in this file. At run time, the coordinator
# loads TIDBCLOUD_PUBLIC_KEY/TIDBCLOUD_PRIVATE_KEY from
# ~/.config/tidb-lab/secrets.env, and exports AWS_PROFILE=DBaaS-DevUser-Role
# for the AWS CLI/SDK credential chain (not a Terraform variable).
TIDBCLOUD_PUBLIC_KEY=
TIDBCLOUD_PRIVATE_KEY=
# Optional: look this up with infra/scripts/lookup-project-id.sh once
# TIDBCLOUD_PUBLIC_KEY/PRIVATE_KEY are set in the environment; leave empty to
# use the account's default project.
TIDBCLOUD_PROJECT_ID=
TIDBCLOUD_REGION_ID=aws-us-west-2
TIDB_ROOT_PASSWORD=
AWS_REGION=us-west-2
# private (default): connect over PrivateLink, this demo's second act.
# public_tls: fallback path, see README's "Connectivity modes" section.
CONNECTION_MODE=private
APP_IMAGE=

TIDB_NODE_COUNT=1
TIKV_NODE_COUNT=3
EKS_NODE_DESIRED_SIZE=2

# The scale act raises TIDB_NODE_COUNT from 1 to 2 (TiDB Cloud's own
# recommended minimum for HA) rather than TiKV, since TiKV's minimum of 3
# nodes is already TiDB Cloud's hard floor and cannot go lower or be safely
# raised by only 1-2 nodes without changing the demo's cost profile more
# than this act needs to.
SCALE_TIDB_NODE_COUNT=2
LOAD_BURST_RPS=50
LOAD_STEADY_RPS=10
LOAD_PHASE_MS=30000

# --- Cost inputs used by the runner's estimated-hourly-cost metric ---
# Every PRICE_* value below is read at runtime; the runner never hardcodes
# a number (demos/terraform-eks/runner/src/cost.ts). Defaults here are the
# current published on-demand rates as of 2026-09-28; re-check the cited
# page before a recording session, since cloud prices change.

# AWS EKS pricing page, "Amazon EKS Standard" support tier:
# https://aws.amazon.com/eks/pricing/ (checked 2026-09-28): $0.10/cluster/hr.
PRICE_EKS_CONTROL_PLANE_USD_HR=0.10

# t4g.medium (arm64), on-demand Linux, us-west-2. This demo's node group
# uses t4g.medium (see infra/terraform/eks.tf); AWS publishes the same rate
# for t3.medium-class Graviton instances across us-east-1/us-west-2.
# Source: instances.vantage.sh/aws/ec2/t4g.medium (checked 2026-09-28).
PRICE_EC2_NODE_USD_HR=0.0336

# Not billed by this demo (infra/terraform/vpc.tf sets enable_nat_gateway =
# false; worker nodes run in public subnets instead, see that file's
# comment for the tradeoff). Kept here, priced at AWS's standard published
# rate, for anyone who re-enables a NAT gateway.
# Source: https://aws.amazon.com/vpc/pricing/ (checked 2026-09-28): $0.045/hr.
PRICE_NAT_GATEWAY_USD_HR=0.045

# One AWS PrivateLink Interface VPC endpoint (infra/terraform/private_link.tf),
# billed per AZ-hour; this demo places it in a single subnet/AZ.
# Source: https://aws.amazon.com/privatelink/pricing/ (checked 2026-09-28):
# $0.01 per AZ-hour (the page's own wording: "billed for each hour that
# your VPC endpoint remains provisioned in each Availability Zone").
PRICE_VPC_ENDPOINT_USD_HR=0.01

# TiDB Cloud Dedicated, smallest published node spec (4 vCPU / 16 GiB,
# node_spec_key "4C16G"), AWS Oregon (us-west-2).
# Source: https://www.pingcap.com/tidb-dedicated-pricing-details/
# (checked 2026-09-28): $0.4416/hr for both the TiDB and TiKV node types at
# this spec (they happen to match at the smallest size).
PRICE_TIDB_TIDB_NODE_USD_HR=0.4416
PRICE_TIDB_TIKV_NODE_USD_HR=0.4416

LAB_ENV_COMPONENT_TERRAFORM=1.9.0
LAB_ENV_COMPONENT_AWS_PROVIDER=hashicorp/aws 6.66.0
LAB_ENV_COMPONENT_KUBERNETES_PROVIDER=hashicorp/kubernetes 3.2.1
LAB_ENV_COMPONENT_TIDBCLOUD_PROVIDER=tidbcloud/tidbcloud 0.4.11
LAB_ENV_COMPONENT_EKS=1.33
